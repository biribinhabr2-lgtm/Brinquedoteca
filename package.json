{
  "name": "recreasoft",
  "version": "2.0.0",
  "description": "RecreaSoft - Sistema de gestão de brinquedoteca",
  "main": "main.js",
  "author": "Quintal Turma da Tia Carol",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.quintal.recreasoft",
    "productName": "RecreaSoft",
    "copyright": "© 2026 Quintal Turma da Tia Carol",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "Quintal Turma da Tia Carol"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RecreaSoft",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "portable": {
      "artifactName": "RecreaSoft-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "^25.1.8"
  }
}
